---
const screens = [
	{
		label: "Inicio",
		gradient: "from-primary/30 via-primary/5 to-transparent",
		mock: "summary",
	},
	{
		label: "Reportes",
		gradient: "from-income/30 via-income/5 to-transparent",
		mock: "chart",
	},
	{
		label: "Préstamos",
		gradient: "from-expense/25 via-expense/5 to-transparent",
		mock: "list",
	},
];
---

<section id="app" class="relative mx-auto max-w-6xl px-4 py-24 md:py-32">
	<div class="reveal mx-auto mb-16 max-w-2xl text-center">
		<span class="mb-4 inline-block text-sm font-semibold uppercase tracking-widest text-secondary">La app</span>
		<h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">Diseñada para verse tan clara como se siente</h2>
		<p class="mt-4 text-text-secondary">Vista previa conceptual de la interfaz — próximamente con capturas reales de la app.</p>
	</div>

	<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
		{
			screens.map((s, i) => (
				<div class="reveal flex flex-col items-center" style={`transition-delay:${i * 100}ms`}>
					<div class="relative mx-auto aspect-[9/19] w-full max-w-[260px] overflow-hidden rounded-[2.2rem] border-4 border-surface-elevated bg-surface shadow-[0_30px_80px_-25px_rgba(0,0,0,0.4)]">
						<div class={`absolute inset-0 bg-gradient-to-b ${s.gradient}`} />
						<div class="absolute inset-x-0 top-0 flex justify-center pt-2">
							<div class="h-5 w-24 rounded-full bg-surface-elevated/80" />
						</div>

						<div class="relative flex h-full flex-col gap-3 px-4 pt-14 pb-6">
							{s.mock === "summary" && (
								<>
									<div class="h-4 w-2/3 rounded-full bg-text-primary/10" />
									<div class="h-20 rounded-2xl bg-primary/20" />
									<div class="grid grid-cols-2 gap-2">
										<div class="h-14 rounded-xl bg-surface-elevated" />
										<div class="h-14 rounded-xl bg-surface-elevated" />
									</div>
									<div class="mt-2 h-3 w-1/2 rounded-full bg-text-primary/10" />
									<div class="space-y-2">
										<div class="h-10 rounded-xl bg-surface-elevated" />
										<div class="h-10 rounded-xl bg-surface-elevated" />
										<div class="h-10 rounded-xl bg-surface-elevated" />
									</div>
								</>
							)}
							{s.mock === "chart" && (
								<>
									<div class="h-4 w-1/2 rounded-full bg-text-primary/10" />
									<div class="mx-auto my-4 grid size-32 place-items-center rounded-full border-[14px] border-income/70 border-r-secondary/70 border-b-primary/70" />
									<div class="flex items-end justify-between gap-1.5 px-2">
										{[40, 65, 35, 80, 55, 90, 70].map((h) => (
											<div class="w-full rounded-t-md bg-secondary/60" style={`height:${h}px`} />
										))}
									</div>
								</>
							)}
							{s.mock === "list" && (
								<>
									<div class="h-4 w-1/2 rounded-full bg-text-primary/10" />
									{[1, 2, 3, 4].map(() => (
										<div class="flex items-center gap-3 rounded-xl bg-surface-elevated p-3">
											<div class="size-9 shrink-0 rounded-full bg-expense/25" />
											<div class="flex-1 space-y-1.5">
												<div class="h-2.5 w-3/4 rounded-full bg-text-primary/10" />
												<div class="h-2 w-1/2 rounded-full bg-text-primary/10" />
											</div>
										</div>
									))}
								</>
							)}
						</div>
					</div>
					<p class="mt-5 text-sm font-medium text-text-secondary">{s.label}</p>
				</div>
			))
		}
	</div>
</section>
