---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-surface-border">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-10 text-center md:flex-row md:justify-between md:text-left">
		<a href="#" class="flex items-center gap-2.5">
			<img src="/assets/icon-192.png" alt="FinaControl" class="size-8 rounded-lg" width="32" height="32" />
			<span class="font-display text-base font-bold tracking-tight">
				<span class="text-text-primary">fina</span><span class="text-income">control</span>
			</span>
		</a>

		<p class="text-sm text-text-secondary">
			© {year} FinaControl. Construida con Kotlin Multiplatform &amp; Compose Multiplatform.
		</p>
	</div>
</footer>
