---
import DownloadTile from "./DownloadTile.astro";
import { PLATFORM_ICONS } from "../lib/platform-icons";

const tiles = [
	{
		name: "Android",
		icon: PLATFORM_ICONS.android,
		format: "APK",
		size: "20 MB",
		href: "/downloads/finacontrol-1.3.8.apk",
		active: true,
	},
	{
		name: "Linux",
		icon: PLATFORM_ICONS.linux,
		format: "Paquete .deb",
		size: "100 MB",
		href: "/downloads/finacontrol_1.3.8_amd64.deb",
		active: true,
	},
	{
		name: "Windows",
		icon: PLATFORM_ICONS.windows,
		format: "Instalador .msi",
		size: "111 MB",
		href: "/downloads/finacontrol_1.3.8.msi",
		active: true,
	},
	{
		name: "macOS",
		icon: PLATFORM_ICONS.apple,
		format: "Imagen .dmg",
		active: false,
	},
];
---

<section id="descargas" class="relative mx-auto max-w-6xl px-4 py-24 md:py-32">
	<div class="reveal mx-auto mb-16 max-w-2xl text-center">
		<span class="mb-4 inline-block text-sm font-semibold uppercase tracking-widest text-secondary">Descargas</span>
		<h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">Llévate FinaControl a tu dispositivo</h2>
		<p class="mt-4 text-text-secondary">v1.1.0 — Android y Linux disponibles hoy. Windows y macOS, muy pronto.</p>
	</div>

	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			tiles.map((tile, i) => (
				<DownloadTile
					name={tile.name}
					icon={tile.icon}
					format={tile.format}
					size={tile.size}
					href={tile.href}
					active={tile.active}
					delay={i * 80}
				/>
			))
		}
	</div>

	<p class="reveal mt-10 text-center text-xs text-text-secondary">
		El APK se firma con clave de depuración para distribución directa; habilita "orígenes desconocidos" al instalar en Android.
	</p>
</section>
