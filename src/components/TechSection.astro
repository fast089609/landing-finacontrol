---
const stack = [
	{ label: "Kotlin Multiplatform", detail: "Un solo código base compartido entre plataformas" },
	{ label: "Compose Multiplatform", detail: "Interfaz nativa, fluida, 100% declarativa" },
	{ label: "SQLDelight", detail: "Base de datos local, tipada y sin fricción" },
	{ label: "Sin nube obligatoria", detail: "Tus datos viven en tu dispositivo" },
];
---

<section id="tecnologia" class="relative overflow-hidden py-24 md:py-32">
	<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent"></div>

	<div class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-16 px-4 lg:grid-cols-2">
		<div class="reveal">
			<span class="mb-4 inline-block text-sm font-semibold uppercase tracking-widest text-secondary">Tecnología</span>
			<h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">Un solo código. Todas tus plataformas.</h2>
			<p class="mt-4 max-w-lg text-text-secondary">
				FinaControl está construida con Kotlin Multiplatform y Compose Multiplatform, lo que significa
				una única base de código compartida entre Android y escritorio — la misma experiencia,
				la misma velocidad, sin compromisos.
			</p>

			<ul class="mt-8 space-y-4">
				{
					stack.map((item) => (
						<li class="flex items-start gap-3">
							<span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-income/15 text-income">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
									<path d="M20 6L9 17l-5-5" />
								</svg>
							</span>
							<div>
								<p class="font-medium text-text-primary">{item.label}</p>
								<p class="text-sm text-text-secondary">{item.detail}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<div class="reveal [transition-delay:120ms]">
			<div class="relative rounded-3xl border border-surface-border bg-surface/60 p-6 backdrop-blur-xl md:p-10">
				<div class="pointer-events-none absolute -right-10 -top-10 size-40 rounded-full bg-secondary/25 blur-3xl"></div>
				<div class="pointer-events-none absolute -bottom-10 -left-10 size-40 rounded-full bg-primary/25 blur-3xl"></div>

				<svg viewBox="0 0 400 220" class="relative w-full" fill="none">
					<g stroke="var(--surface-border)" stroke-width="1">
						<line x1="0" y1="40" x2="400" y2="40" />
						<line x1="0" y1="90" x2="400" y2="90" />
						<line x1="0" y1="140" x2="400" y2="140" />
						<line x1="0" y1="190" x2="400" y2="190" />
					</g>
					<path
						d="M10 170 L70 120 L130 145 L190 70 L250 95 L310 40 L390 20"
						stroke="var(--secondary)"
						stroke-width="3"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-dasharray="600"
						stroke-dashoffset="600"
						class="animate-dash"
					/>
					<path
						d="M10 170 L70 120 L130 145 L190 70 L250 95 L310 40 L390 20"
						stroke="var(--primary)"
						stroke-width="3"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-dasharray="600"
						stroke-dashoffset="600"
						class="animate-dash opacity-40"
						style="animation-delay: 0.3s"
					/>
					{
						[
							[10, 170],
							[70, 120],
							[130, 145],
							[190, 70],
							[250, 95],
							[310, 40],
							[390, 20],
						].map(([cx, cy]) => <circle cx={cx} cy={cy} r="5" fill="var(--bg)" stroke="var(--secondary)" stroke-width="2.5" />)
					}
				</svg>
			</div>
		</div>
	</div>
</section>
