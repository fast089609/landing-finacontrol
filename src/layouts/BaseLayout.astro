---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "FinaControl — Control financiero multiplataforma",
	description = "FinaControl: la app de finanzas personales para cuentas, monedas, préstamos y reportes visuales. Disponible para Android y Linux.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/og-image.png", Astro.site);
const ogImageAlt = "Logo de FinaControl junto al nombre de la app sobre un fondo oscuro con acentos violeta y verde";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "FinaControl",
	description,
	url: canonicalURL.toString(),
	image: ogImageURL.toString(),
	applicationCategory: "FinanceApplication",
	operatingSystem: "Android, Linux",
	softwareVersion: "1.1.0",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0d17" />

		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/assets/icon-192.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="FinaControl" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@FC089609" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

		<script is:inline>
			(function () {
				const stored = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				if (stored === "dark" || (!stored && prefersDark)) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body class="bg-bg text-text-primary font-sans antialiased selection:bg-primary">
		<slot />

		<script>
			const revealEls = document.querySelectorAll(".reveal");
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 },
			);
			for (const el of revealEls) observer.observe(el);
		</script>
	</body>
</html>
